+    // vkCmdClearAttachments in calls of at most 80 rectangles on Switch 2
+    // (ouncevk#2, still open in OunceVK 20261123). Mesa NVK's emit_clear_rects
+    // (nvk_cmd_clear.c) writes 6 command words per rectangle into one push it
+    // never splits, and its command memory comes in 64 KiB blocks
+    // (NVK_CMD_MEM_SIZE, 16384 words): above 2730 rectangles the push runs
+    // into the next command buffer's commands and the GPU stops with a PBDMA
+    // error (VK_ERROR_DEVICE_LOST). Xbox 360 EDRAM tile-split clears reach
+    // thousands of rectangles. 80 * 6 = 480 words fits NVK_CMD_BUFFER_MAX_PUSH
+    // (512). Same limit as LostOdysseyRecomp (gpu/renderer.cpp, commit 65d6b70a).
+    static void cmdClearAttachmentsChunked(VkCommandBuffer commandBuffer, const VkClearAttachment &attachment, const std::vector<VkClearRect> &rects) {
+#   if defined(__SWITCH2__)
+        constexpr size_t kMaxClearRects = 80;
+        for (size_t first = 0; first < rects.size(); first += kMaxClearRects) {
+            const size_t count = std::min(kMaxClearRects, rects.size() - first);
+            vkCmdClearAttachments(commandBuffer, 1, &attachment, uint32_t(count), rects.data() + first);
+        }
+#   else
+        vkCmdClearAttachments(commandBuffer, 1, &attachment, uint32_t(rects.size()), rects.data());
+#   endif
+    }
